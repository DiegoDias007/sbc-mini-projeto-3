    hxh:apareceEm hxh:ArcoYorknew .

# Hisoka entrou na Trupe só para lutar com Chrollo; a tatuagem dele era falsa.
hxh:Hisoka a hxh:Humano ; rdfs:label "Hisoka Morow"@pt ;
